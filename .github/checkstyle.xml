<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle Configuration – RetourMarche (Spring Boot / Java 17)
  ================================================================
  Based on Google Java Style Guide with pragmatic adjustments for a
  Spring Boot project using Lombok, Thymeleaf, and JPA conventions.

  Severity levels:
    • error   → would fail the build if failsOnError=true
    • warning → reported as annotation on PRs but never blocks

  Reference: https://checkstyle.org/checks.html
-->
<module name="Checker">

  <!-- ── Global settings ─────────────────────────────────────────────── -->
  <property name="severity"        value="warning"/>
  <property name="fileExtensions"  value="java"/>
  <property name="charset"         value="UTF-8"/>

  <!-- Suppress checks on generated / Lombok sources -->
  <module name="SuppressWarningsFilter"/>
  <module name="BeforeExecutionExclusionFileFilter">
    <property name="fileNamePattern" value=".*[\\/]target[\\/].*"/>
  </module>

  <!-- ── File-level checks ───────────────────────────────────────────── -->

  <!-- No tab characters (use spaces) -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <!-- No trailing whitespace -->
  <module name="RegexpSingleline">
    <property name="format"  value="\s+$"/>
    <property name="message" value="Line has trailing whitespace."/>
  </module>

  <!-- Files must end with a newline -->
  <module name="NewlineAtEndOfFile"/>

  <!-- Line length: 120 chars (relaxed from Google's 100 for Spring verbosity) -->
  <module name="LineLength">
    <property name="max"            value="120"/>
    <property name="ignorePattern"  value="^(\s*\*|.*import|.*\*/).*$"/>
  </module>

  <!-- ── Tree-walker checks (AST-level) ─────────────────────────────── -->
  <module name="TreeWalker">

    <!-- Allows @SuppressWarnings("checkstyle:...") on individual elements -->
    <module name="SuppressWarningsHolder"/>

    <!-- ── Naming conventions ─────────────────────────────────────── -->
    <module name="TypeName"/>           <!-- PascalCase for classes/interfaces -->
    <module name="MethodName"/>         <!-- camelCase for methods -->
    <module name="LocalVariableName"/>  <!-- camelCase for local vars -->
    <module name="MemberName"/>         <!-- camelCase for fields -->
    <module name="ParameterName"/>      <!-- camelCase for parameters -->
    <module name="ConstantName"/>       <!-- UPPER_SNAKE for static final -->
    <module name="PackageName">         <!-- lowercase package names -->
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>

    <!-- ── Imports ─────────────────────────────────────────────────── -->
    <module name="AvoidStarImport"/>          <!-- no wildcard imports -->
    <module name="UnusedImports"/>            <!-- no dead imports -->
    <module name="IllegalImport">             <!-- block internal sun.* APIs -->
      <property name="illegalPkgs" value="sun, com.sun"/>
    </module>
    <module name="RedundantImport"/>          <!-- no duplicate imports -->

    <!-- ── Javadoc ─────────────────────────────────────────────────── -->
    <!-- Public methods/classes should have Javadoc (warn only) -->
    <module name="MissingJavadocMethod">
      <property name="scope"              value="public"/>
      <!-- property name="allowMissingParamTags"  value="false"/ -->
      <!-- property name="allowMissingReturnTag"  value="true"/ -->
      <property name="severity"           value="warning"/>
    </module>

    <!-- ── Code style ──────────────────────────────────────────────── -->

    <!-- Brace placement -->
    <module name="LeftCurly"/>
    <module name="RightCurly"/>
    <module name="NeedBraces"/>   <!-- always use braces, even for single-line if -->

    <!-- Whitespace around operators and keywords -->
    <module name="WhitespaceAfter"/>
    <module name="WhitespaceAround">
      <property name="allowEmptyConstructors" value="true"/>
      <property name="allowEmptyMethods"      value="true"/>
      <property name="allowEmptyTypes"        value="true"/>
      <property name="allowEmptyLambdas"      value="true"/>
    </module>
    <module name="NoWhitespaceBefore"/>

    <!-- One statement per line -->
    <module name="OneStatementPerLine"/>

    <!-- No empty catch blocks without a comment -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="ignored|expected"/>
    </module>

    <!-- ── Code quality ─────────────────────────────────────────────── -->

    <!-- Avoid magic numbers (except common ones) -->
    <module name="MagicNumber">
      <property name="ignoreNumbers"          value="-1, 0, 1, 2, 100"/>
      <property name="ignoreAnnotation"       value="true"/>
      <property name="ignoreHashCodeMethod"   value="true"/>
    </module>

    <!-- No System.out.println (use SLF4J logger instead) -->
    <module name="RegexpSinglelineJava">
      <property name="format"   value="System\.(out|err)\.print"/>
      <property name="message"  value="Use a logger instead of System.out/err."/>
      <property name="ignoreComments" value="true"/>
    </module>

    <!-- Cyclomatic complexity: warn when methods get too complex -->
    <module name="CyclomaticComplexity">
      <property name="max"      value="15"/>
      <property name="severity" value="warning"/>
    </module>

    <!-- Simplify boolean expressions -->
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <!-- Detect unnecessary else after return/throw -->
    <module name="UnnecessaryParentheses"/>

    <!-- Detect shadowed variables -->
    <module name="HiddenField">
      <property name="ignoreSetter"          value="true"/>
      <property name="ignoreConstructorParameter" value="true"/>
    </module>

    <!-- No multiple variable declarations per statement -->
    <module name="MultipleVariableDeclarations"/>

    <!-- Modifier order: public protected private abstract static ... -->
    <module name="ModifierOrder"/>

    <!-- Detect redundant modifiers (e.g. public on interface methods) -->
    <module name="RedundantModifier"/>

    <!-- toString, equals, hashCode should be overridden together -->
    <module name="EqualsHashCode"/>

  </module>
</module>
